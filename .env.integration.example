# Global opt-in for every real-browser integration test.
ONE_BROWSER_INTEGRATION=0

# Required: installed native 1Browser executable and a dedicated persistent
# test directory. Never share this directory between concurrent test runs.
ONE_BROWSER_PATH=/absolute/path/to/1browser
ONE_USER_DATA_DIR=/absolute/path/to/dedicated/1browser-sdk-integration-data

# Required only when the persistent test session is not already authenticated.
ONE_EMAIL=
ONE_PASSWORD=

# Optional existing profile for read-only fingerprint and proxy tests. When
# omitted, the first persistent profile is used, or a temporary owned profile
# is created when the account has none.
ONE_INTEGRATION_PROFILE_ID=

# Account actions. Signup requires unique, previously unused credentials and a
# user-data directory different from ONE_USER_DATA_DIR.
ONE_BROWSER_SIGNUP=0
ONE_SIGNUP_EMAIL=
ONE_SIGNUP_PASSWORD=
ONE_SIGNUP_USER_DATA_DIR=/absolute/path/to/dedicated/1browser-sdk-signup-data
ONE_BROWSER_VERIFY=0

# Profile tests.
ONE_BROWSER_PROFILE_CRUD=0
ONE_PROFILE_CRUD_COUNT=2
ONE_PROFILE_CRUD_PREFIX=SDK CRUD Test
ONE_PROFILE_CRUD_QUOTA_TIMEOUT_MS=30000
ONE_PROFILE_CRUD_DELETE_TIMEOUT_MS=30000

# Fingerprint mutations run only on profiles owned and deleted by the test.
ONE_FINGERPRINT_SETTING=screen_resolution
ONE_BROWSER_FINGERPRINT_WRITE=0
ONE_FINGERPRINT_TEST_VALUE=800x600
ONE_BROWSER_FINGERPRINT_GENERATE=0

# Proxy mutations run only on profiles owned and deleted by the test.
ONE_BROWSER_PROXY_WRITE=0
ONE_PROXY_TEST_URL=http://127.0.0.1:9
ONE_BROWSER_PROXY_ACTIONS=0

# Optional paid proxy success-path test. This changes the proxy assigned to
# the explicitly named existing test profile and may consume paid traffic.
ONE_BROWSER_PROXY_PAID_REQUEST=0
ONE_PROXY_PAID_PROFILE_ID=
