{
  "name": "@1browser/sdk",
  "version": "0.1.0",
  "description": "Node.js SDK for safe 1Browser profile automation",
  "main": "src/index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "require": "./src/index.js",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "index.d.ts",
    "README.md",
    "docs/node-sdk.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check src/index.js && node --check src/client.js && node --check src/config.js && node --check src/errors.js && node --check src/auth.js && node --check src/auth-operations.js && node --check src/profiles.js && node --check src/fingerprint.js && node --check src/proxy.js && node --check src/targets.js && node --check src/concurrency.js && node --check src/results.js && node --check scripts/integration-test-support.js && node --check scripts/run-integration-tests.js",
    "test": "node --test",
    "test:integration": "node scripts/run-integration-tests.js",
    "test:integration:file": "node scripts/run-integration-tests.js --file",
    "test:integration:account": "node scripts/run-integration-tests.js --group account",
    "test:integration:profiles": "node scripts/run-integration-tests.js --group profiles",
    "test:integration:fingerprint": "node scripts/run-integration-tests.js --group fingerprint",
    "test:integration:proxy": "node scripts/run-integration-tests.js --group proxy",
    "test:integration:profile-crud": "node scripts/run-integration-tests.js --file profiles/profile-crud.test.js",
    "pack:check": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "puppeteer-core": "25.3.0"
  },
  "keywords": [
    "1browser",
    "browser-automation",
    "cdp",
    "puppeteer"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/the1browser/1browser.git"
  },
  "homepage": "https://github.com/the1browser/1browser",
  "license": "MIT"
}
