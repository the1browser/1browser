# Optional override. Native 1Browser installations are discovered automatically.
# Never point this at system Chrome or Chromium.
ONE_BROWSER_PATH=/absolute/path/to/1browser

# Optional override. Otherwise a stable application-specific path is created.
ONE_USER_DATA_DIR=/absolute/path/to/persistent/1browser-automation-data

# Required only when the persisted session is unavailable.
ONE_EMAIL=<email>
ONE_PASSWORD=<password>

# Required only by the create-profile example.
ONE_PROFILE_NAME=Automation Profile

# Required only by the configure-proxy example.
ONE_PROXY_URL=http://user:password@host:8080

# Used only by the signup example. Keep ONE_ALLOW_SIGNUP=0 until the
# credentials identify a new test account that may be created.
ONE_ALLOW_SIGNUP=0
ONE_SIGNUP_EMAIL=<new-test-account-email>
ONE_SIGNUP_PASSWORD=<new-test-account-password>

# Used only by the verification example.
ONE_ALLOW_VERIFY=0

# Used by the fingerprint settings example. Reading is always enabled.
# A non-empty value changes the selected setting; generation requires opt-in.
ONE_FINGERPRINT_SETTING=screen_resolution
ONE_FINGERPRINT_VALUE=
ONE_GENERATE_FINGERPRINT=0

# Used by the proxy actions example. A non-empty type changes the active type.
# Requesting a new paid catalog proxy requires a separate opt-in.
ONE_PROXY_TYPE=
ONE_REQUEST_NEW_PROXY=0

# Used only by the multi-profile Amazon search example.
ONE_PROFILE_COUNT=5
ONE_PROFILE_PREFIX=Amazon Search
ONE_TARGET_URL=https://www.amazon.com
ONE_SEARCH_QUERY=iphone
ONE_CONCURRENCY=2
